{
  "name": "app-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-api": "openapi-typescript ../backend/target/generated/openapi/openapi.yaml -o src/api/schema.d.ts",
    "verify": "tsc --noEmit && lit-analyzer \"src/**/*.ts\" --strict",
    "build": "npm run verify && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "lit-analyzer": "^2.0.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
